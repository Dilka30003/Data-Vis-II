{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "params": [
    {
      "name": "profileState",
      "value": "VIC"
    }
  ],
  "data": {
    "url": "data/adii_state_scores.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof([\"Access\",\"Affordability\",\"Digital ability\",\"Index\"],datum.measure)",
      "as": "dimension_order"
    }
  ],
  "encoding": {
    "x": {
      "field": "measure",
      "type": "ordinal",
      "sort": [
        "Access",
        "Affordability",
        "Digital ability",
        "Index"
      ],
      "axis": {
        "title": null,
        "grid": true,
        "labelAngle": 0,
        "labelPadding": 13,
        "labelLimit": 120
      }
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "domain": [
          60,
          85
        ],
        "nice": false
      },
      "axis": {
        "title": "ADII score (cropped 60–85)",
        "values": [
          60,
          65,
          70,
          75,
          80,
          85
        ]
      }
    },
    "detail": {
      "field": "state"
    },
    "order": {
      "field": "dimension_order",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "state_name",
        "title": "State / territory",
        "type": "nominal"
      },
      {
        "field": "measure",
        "title": "Dimension",
        "type": "nominal"
      },
      {
        "field": "score",
        "title": "Score / 100",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.state !== profileState"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#bac5b1",
        "opacity": 0.72,
        "strokeWidth": 1.6,
        "point": {
          "filled": true,
          "size": 26,
          "color": "#bac5b1"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === profileState"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#225844",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 68,
          "color": "#225844"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === profileState && datum.measure === 'Index'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -15,
        "fontWeight": 600,
        "color": "#225844",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "state"
        }
      }
    }
  ]
}