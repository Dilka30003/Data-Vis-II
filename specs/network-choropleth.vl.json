{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "params": [
    {
      "name": "operatorChoice",
      "value": "Telstra"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australian_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eceee3",
        "stroke": "#fffefa",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/network_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2026 && datum.operator === operatorChoice && isValid(datum.longitude)"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/australian_states.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.state"
          },
          "as": "geometry"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffefa",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "five_g_site_share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#eef0e5",
              "#225844"
            ]
          },
          "legend": {
            "title": "5G site share (%)",
            "direction": "horizontal",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "operator",
            "title": "Operator",
            "type": "nominal"
          },
          {
            "field": "total_sites",
            "title": "All site records",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "five_g_sites",
            "title": "5G site records",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "five_g_site_share",
            "title": "5G site share (%)",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/network_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2026 && datum.operator === operatorChoice && isValid(datum.longitude)"
        },
        {
          "filter": "datum.state !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 500,
        "color": "#1e3427"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "operator",
            "title": "Operator",
            "type": "nominal"
          },
          {
            "field": "total_sites",
            "title": "All site records",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "five_g_sites",
            "title": "5G site records",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "five_g_site_share",
            "title": "5G site share (%)",
            "type": "quantitative",
            "format": ".1f"
          }
        ],
        "color": {
          "condition": {
            "test": "datum.five_g_site_share > 60",
            "value": "white"
          },
          "value": "#1e3427"
        }
      }
    }
  ]
}