{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "params": [
    {
      "name": "inclusionDimension",
      "value": "Index"
    }
  ],
  "data": {
    "url": "data/adii_state_scores.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.measure === inclusionDimension"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#dbe1cf",
        "height": 15
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": null,
            "tickCount": 5
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "title": null,
            "grid": false
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 64,
        "color": "#225844"
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "measure",
            "title": "Dimension",
            "type": "nominal"
          },
          {
            "field": "score",
            "title": "Score / 100",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "color": "#225844",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x"
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}