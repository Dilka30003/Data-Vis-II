{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "params": [
    {
      "name": "operatorChoice",
      "value": "Telstra"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australian_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eceee3",
        "stroke": "#fffefa",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/network_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2026 && datum.operator === operatorChoice && isValid(datum.longitude)"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#b2592c",
        "opacity": 0.75,
        "stroke": "#fffefa",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "black_spot_sites",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              450
            ],
            "range": [
              0,
              2800
            ]
          },
          "legend": {
            "title": "Site records",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              50,
              150,
              300
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "operator",
            "title": "Operator",
            "type": "nominal"
          },
          {
            "field": "black_spot_sites",
            "title": "Black Spot Program site records",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/network_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2026 && datum.operator === operatorChoice && isValid(datum.longitude)"
        },
        {
          "filter": "!isValid(datum.black_spot_sites)"
        },
        {
          "calculate": "'No published value'",
          "as": "missing_note"
        }
      ],
      "mark": {
        "type": "text",
        "text": "×",
        "fontSize": 14,
        "color": "#646c60"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "operator",
            "title": "Operator",
            "type": "nominal"
          },
          {
            "field": "missing_note",
            "title": "Black Spot Program sites",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/network_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2026 && datum.operator === operatorChoice && isValid(datum.longitude)"
        },
        {
          "filter": "datum.state !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -15,
        "fontSize": 12,
        "color": "#3e4537"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}