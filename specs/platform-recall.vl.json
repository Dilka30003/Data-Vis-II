{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "data": {
    "url": "data/platform_trends.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2025 && indexof(['Facebook','YouTube','WhatsApp','Instagram','TikTok','Snapchat'],datum.platform)>=0"
    },
    {
      "lookup": "platform",
      "from": {
        "data": {
          "url": "data/platform_weekly_2025.csv",
          "format": {
            "type": "csv",
            "parse": {
              "year": "number",
              "percent": "number",
              "base_n": "number",
              "response_n": "number",
              "total_sites": "number",
              "five_g_sites": "number",
              "five_g_site_share": "number",
              "black_spot_sites": "number",
              "longitude": "number",
              "latitude": "number",
              "five_g_present": "number",
              "source_row": "number",
              "records_at_same_id_coordinates": "number",
              "score": "number",
              "data_year": "number"
            }
          }
        },
        "key": "platform",
        "fields": [
          "percent"
        ]
      },
      "as": [
        "weekly"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#c6cdbe",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": null,
            "labelExpr": "datum.value + '%'",
            "tickCount": 5
          }
        },
        "x2": {
          "field": "weekly"
        },
        "y": {
          "field": "platform",
          "type": "nominal",
          "sort": [
            "Facebook",
            "YouTube",
            "WhatsApp",
            "Instagram",
            "TikTok",
            "Snapchat"
          ],
          "axis": {
            "title": null,
            "grid": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "percent",
            "weekly"
          ],
          "as": [
            "period",
            "value"
          ]
        },
        {
          "calculate": "datum.period === 'percent' ? 'Past six months' : 'Past seven days'",
          "as": "recall"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "y": {
          "field": "platform",
          "type": "nominal",
          "sort": [
            "Facebook",
            "YouTube",
            "WhatsApp",
            "Instagram",
            "TikTok",
            "Snapchat"
          ]
        },
        "color": {
          "field": "recall",
          "type": "nominal",
          "scale": {
            "domain": [
              "Past six months",
              "Past seven days"
            ],
            "range": [
              "#b0b5a6",
              "#b2592c"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "platform",
            "title": "Website/app",
            "type": "nominal"
          },
          {
            "field": "recall",
            "title": "Recall period",
            "type": "nominal"
          },
          {
            "field": "value",
            "title": "Adults (%)",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}