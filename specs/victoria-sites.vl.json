{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "siteFilter",
      "value": "all"
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australian_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.state === 'VIC'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eeefe6",
        "stroke": "#c1c8b8",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/telstra_sites_victoria_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number",
            "base_n": "number",
            "response_n": "number",
            "total_sites": "number",
            "five_g_sites": "number",
            "five_g_site_share": "number",
            "black_spot_sites": "number",
            "longitude": "number",
            "latitude": "number",
            "five_g_present": "number",
            "source_row": "number",
            "records_at_same_id_coordinates": "number",
            "score": "number",
            "data_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "siteFilter === 'all' || (siteFilter === '5g' && datum.five_g_present === 1) || (siteFilter === 'other' && datum.five_g_present === 0)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 16,
        "opacity": 0.65,
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {
            "domain": [
              "5G present",
              "No 5G band recorded"
            ],
            "range": [
              "#225844",
              "#b2592c"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "site_id",
            "title": "RFNSA ID",
            "type": "nominal"
          },
          {
            "field": "technology",
            "title": "Radio-band record",
            "type": "nominal"
          },
          {
            "field": "co_funded",
            "title": "Co-funded field",
            "type": "nominal"
          },
          {
            "field": "records_at_same_id_coordinates",
            "title": "Records sharing ID/location",
            "type": "quantitative"
          },
          {
            "field": "source_row",
            "title": "Original CSV row",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Melbourne",
            "longitude": 144.9631,
            "latitude": -37.8136
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 10,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#202e27"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "city"
        }
      }
    }
  ]
}