{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "params": [
    {
      "name": "operatorChoice",
      "value": "Telstra"
    }
  ],
  "data": {
    "url": "data/network_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.operator === operatorChoice && datum.year >= 2020 && datum.year <= 2026"
    },
    {
      "fold": [
        "total_sites",
        "five_g_sites"
      ],
      "as": [
        "metric",
        "sites"
      ]
    },
    {
      "filter": "isValid(datum.sites)"
    },
    {
      "calculate": "datum.metric === 'total_sites' ? 'All sites' : '5G-enabled sites'",
      "as": "series"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2020,
          2026
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "format": "d",
        "values": [
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "sites",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          14000
        ],
        "nice": false
      },
      "axis": {
        "title": "Site records",
        "format": "~s",
        "tickCount": 5
      }
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "scale": {
        "domain": [
          "All sites",
          "5G-enabled sites"
        ],
        "range": [
          "#225844",
          "#b2592c"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "operator",
        "title": "Operator",
        "type": "nominal"
      },
      {
        "field": "year",
        "title": "Reference year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "series",
        "title": "Series",
        "type": "nominal"
      },
      {
        "field": "sites",
        "title": "Site records",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "detail": {
          "field": "series"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 56,
        "stroke": "#fffefa",
        "strokeWidth": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": -12,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "series"
        }
      }
    }
  ]
}