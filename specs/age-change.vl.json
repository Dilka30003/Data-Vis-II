{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "data": {
    "url": "data/phone_age_trends.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2017 || datum.year === 2025"
    },
    {
      "pivot": "year",
      "value": "percent",
      "groupby": [
        "group"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#c6cdbe",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "2017",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": null,
            "labelExpr": "datum.value + '%'",
            "tickCount": 5
          }
        },
        "x2": {
          "field": "2025"
        },
        "y": {
          "field": "group",
          "type": "ordinal",
          "sort": [
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ],
          "axis": {
            "title": null,
            "grid": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "2017",
            "2025"
          ],
          "as": [
            "year",
            "value"
          ]
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 84
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "y": {
          "field": "group",
          "type": "ordinal",
          "sort": [
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ]
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2017",
              "2025"
            ],
            "range": [
              "#b0b5a6",
              "#225844"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Age group",
            "type": "nominal"
          },
          {
            "field": "year",
            "title": "Year",
            "type": "nominal"
          },
          {
            "field": "value",
            "title": "Adults (%)",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}