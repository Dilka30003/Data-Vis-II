{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "data": {
    "url": "data/device_trends.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "params": [
    {
      "name": "deviceMode",
      "value": "core"
    }
  ],
  "transform": [
    {
      "filter": "isValid(datum.percent) && indexof(['Mobile phone','Laptop computer','Desktop computer','Tablet (e.g. iPad, Galaxy Tab)','Smart TVs'],datum.device)>=0"
    },
    {
      "filter": "deviceMode === 'all' || datum.device !== 'Smart TVs'"
    },
    {
      "calculate": "datum.device === 'Tablet (e.g. iPad, Galaxy Tab)' ? 'Tablet' : datum.device",
      "as": "label"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 34
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2017,
          2025
        ]
      },
      "axis": {
        "title": null,
        "format": "d",
        "tickCount": 9,
        "grid": false,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": null,
        "labelExpr": "datum.value + '%'",
        "tickCount": 5
      }
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Mobile phone",
          "Laptop computer",
          "Desktop computer",
          "Tablet",
          "Smart TVs"
        ],
        "range": [
          "#225844",
          "#b2592c",
          "#6e8172",
          "#bba36b",
          "#6a7190"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "label",
        "title": "Device",
        "type": "nominal"
      },
      {
        "field": "percent",
        "title": "Percent",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "base_n",
        "title": "Unweighted base",
        "type": "quantitative",
        "format": ","
      }
    ]
  }
}