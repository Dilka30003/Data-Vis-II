{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 14,
    "top": 8,
    "bottom": 5
  },
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "gridColor": "#e5e7dd",
      "labelPadding": 10,
      "titleFontWeight": 400,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5b655c",
      "titleColor": "#5b655c",
      "orient": "bottom",
      "symbolStrokeWidth": 3
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    },
    "text": {
      "fontSize": 12
    }
  },
  "data": {
    "url": "data/activity_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "percent": "number",
        "base_n": "number",
        "response_n": "number",
        "total_sites": "number",
        "five_g_sites": "number",
        "five_g_site_share": "number",
        "black_spot_sites": "number",
        "longitude": "number",
        "latitude": "number",
        "five_g_present": "number",
        "source_row": "number",
        "records_at_same_id_coordinates": "number",
        "score": "number",
        "data_year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(datum.activity, 'Accessing news')===0 ? 'News & information' : indexof(datum.activity, 'Buying')===0 ? 'Buying goods / services' : indexof(datum.activity, 'Accessing government')===0 ? 'Government apps' : indexof(datum.activity, 'Video conferencing')===0 ? 'Video calls' : indexof(datum.activity, 'Telehealth')===0 ? 'Telehealth' : indexof(datum.activity, 'Working')===0 ? 'Working from home' : indexof(datum.activity, 'Selling')===0 ? 'Selling goods / services' : indexof(datum.activity, 'Studying')===0 ? 'Studying from home' : 'Professional advice'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#225844",
        "height": 17,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": null,
            "labelExpr": "datum.value + '%'",
            "tickCount": 5
          }
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "title": null,
            "labelLimit": 150,
            "grid": false
          }
        },
        "tooltip": [
          {
            "field": "activity",
            "title": "Original question option",
            "type": "nominal"
          },
          {
            "field": "percent",
            "title": "Percent",
            "type": "quantitative",
            "format": ".1f"
          },
          {
            "field": "base_n",
            "title": "Unweighted base",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "color": "#225844",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative"
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": "-x"
        },
        "text": {
          "field": "percent",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}